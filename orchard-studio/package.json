{
  "name": "orchard-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests tools",
    "test": "vitest run",
    "e2e": "playwright test tests/e2e/interactions.spec.ts --trace off",
    "shots": "playwright test tests/e2e/shots.spec.ts --trace off",
    "perf": "playwright test tests/e2e/perf.spec.ts --trace off",
    "assets:fetch": "node tools/fetch-assets.mjs",
    "assets:optimize": "node tools/optimize-assets.mjs",
    "verify": "node tools/verify.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "camera-controls": "^3.1.2",
    "maath": "^0.10.8",
    "n8ao": "^2.1.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stats-gl": "^4.2.3",
    "three": "^0.187.0",
    "three-gpu-pathtracer": "^0.0.28",
    "three-mesh-bvh": "^0.9.18",
    "troika-three-text": "^0.53.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
